# Generated automatically by installer/onboarding.py during installation.
POSTGRES_DB=liferpg
POSTGRES_USER=liferpg
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://liferpg:change-me@postgres:5432/liferpg

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_USER_ID=123456789

LIFERPG_VERSION=1.0.0
LIFERPG_CHARACTER_NAME=Operator
LIFERPG_TIMEZONE=UTC
LIFERPG_FOUNDING_CONFIG=/config/founding.json
LIFERPG_FOCUS_HABIT_CODE=daily_focus
LIFERPG_FOCUS_HABIT_LABEL=Daily Focus
LIFERPG_NUTRITION_ENABLED=true
LIFERPG_NUTRITION_TARGET_KCAL=2200
LIFERPG_WEIGHT_TRACKING_ENABLED=true
LIFERPG_BACKUP_ROOT=/srv/liferpg/backups

LIFERPG_OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:0.8b
COMPOSE_PROFILES=ai

LIFERPG_API_BIND=127.0.0.1
LIFERPG_DASHBOARD_BIND=127.0.0.1
